{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.json",
    "webpack": false,
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      { "include": "assets/**/*", "watchAssets": true, "outDir": "dist/src" },
      { "include": "email/templates/*.hbs", "watchAssets": true, "outDir": "dist/src" },
      { "include": "passes/templates/*.hbs", "watchAssets": true, "outDir": "dist/src" },
      { "include": "email/translations/*.json", "watchAssets": true, "outDir": "dist/src" },
      "**/*.json"
    ]
  },
  "generateOptions": {
    "spec": true,
    "flat": false
  }
}
