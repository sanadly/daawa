{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.json",
    "webpack": false,
    "deleteOutDir": true,
    "assets": ["**/*.hbs", "**/*.ejs"],
    "watchAssets": true
  },
  "generateOptions": {
    "spec": true,
    "flat": false
  }
}
