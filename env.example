# Daawa Event Management System - Environment Variables
# Copy this file to .env and update with your actual values

# Application Configuration
NODE_ENV=development
APP_NAME=Daawa
APP_VERSION=1.0.0
APP_URL=http://localhost:3000
API_URL=http://localhost:3001/api/v1

# Server Configuration
FRONTEND_PORT=3000
BACKEND_PORT=3001
API_PREFIX=api/v1

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=daawa
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=true

# Redis Configuration (for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-this-in-production

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@daawa.com

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# External APIs
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn

# Development Tools
ENABLE_SWAGGER=true
ENABLE_CORS=true
CORS_ORIGIN=http://localhost:3000

# Production Settings (override in production)
# DATABASE_SSL=true
# DATABASE_SYNCHRONIZE=false
# DATABASE_LOGGING=false
# ENABLE_SWAGGER=false
# LOG_LEVEL=warn 

# New environment variables
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRATION=7d

# QR Code JWT Settings
JWT_QR_CODE_SECRET=your-qr-code-secret-key
JWT_QR_CODE_EXPIRATION=365d

# Nodemailer / Email settings
MAIL_HOST=smtp.example.com 