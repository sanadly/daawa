# Development Environment Configuration
NODE_ENV=development

# Application
APP_NAME=Daawa Development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001/api/v1

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=3001

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=daawa_development
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security (Development only - not secure)
JWT_SECRET=dev-jwt-secret-not-secure
JWT_EXPIRES_IN=7d
SESSION_SECRET=dev-session-secret-not-secure

# Development Tools
ENABLE_SWAGGER=true
ENABLE_CORS=true
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Email (Development - use mailtrap or similar)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM=dev@daawa.com 