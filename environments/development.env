# Development Environment Configuration
NODE_ENV=development

# Application
APP_NAME=Daawa Development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001/api/v1

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=3001

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=daawa
DATABASE_PASSWORD=Asb1562002
DATABASE_NAME=daawa
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT Configuration
JWT_ACCESS_SECRET=dev-jwt-access-secret-not-secure
JWT_ACCESS_EXPIRATION=24h
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-not-secure
JWT_REFRESH_EXPIRATION=7d

# QR Code JWT (for passes)
JWT_QR_CODE_SECRET=dev-qr-code-secret-not-secure
JWT_QR_CODE_EXPIRATION=24h

# Secure URL JWT (for time-limited file access)
SECURE_URL_SECRET=dev-secure-url-secret-not-secure

# Legacy JWT (keeping for compatibility)
JWT_ACCESS_SECRE=dev-jwt-secret-not-secure
JWT_EXPIRES_IN=7d
SESSION_SECRET=dev-session-secret-not-secure

# Development Tools
ENABLE_SWAGGER=true
ENABLE_CORS=true
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Email (Development - use mailtrap or similar)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM=dev@daawa.com

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_DEFAULT_BUCKET=daawa-user-uploads

# AWS S3 Buckets
AWS_S3_USER_UPLOADS_BUCKET=daawa-user-uploads
AWS_S3_PROCESSED_IMAGES_BUCKET=daawa-processed-images
AWS_S3_EVENT_ASSETS_BUCKET=daawa-event-assets
AWS_S3_PASS_ASSETS_BUCKET=daawa-pass-assets

# AWS CloudFront CDN (optional)
AWS_CLOUDFRONT_URL=
AWS_CLOUDFRONT_DISTRIBUTION_ID=

# Storage Configuration
STORAGE_MAX_FILE_SIZE=10485760
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf 