# Production Environment Configuration
NODE_ENV=production

# Application
APP_NAME=Daawa
APP_URL=https://daawa.com
API_URL=https://api.daawa.com/api/v1

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=3001

# Database (Use environment variables from secrets manager)
DATABASE_HOST=${PROD_DB_HOST}
DATABASE_PORT=5432
DATABASE_USERNAME=${PROD_DB_USER}
DATABASE_PASSWORD=${PROD_DB_PASSWORD}
DATABASE_NAME=daawa
DATABASE_SSL=true
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# Redis
REDIS_HOST=${PROD_REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${PROD_REDIS_PASSWORD}
REDIS_DB=0

# Security (Use secrets manager - these must be strong)
JWT_SECRET=${PROD_JWT_SECRET}
JWT_EXPIRES_IN=24h
SESSION_SECRET=${PROD_SESSION_SECRET}
BCRYPT_ROUNDS=14

# Production Settings
ENABLE_SWAGGER=false
ENABLE_CORS=true
CORS_ORIGIN=https://daawa.com
LOG_LEVEL=warn

# Email (Production email service)
SMTP_HOST=${PROD_SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${PROD_SMTP_USER}
SMTP_PASSWORD=${PROD_SMTP_PASSWORD}
SMTP_FROM=noreply@daawa.com

# External APIs (Production keys)
GOOGLE_MAPS_API_KEY=${PROD_GOOGLE_MAPS_KEY}
STRIPE_SECRET_KEY=${PROD_STRIPE_SECRET}
STRIPE_PUBLISHABLE_KEY=${PROD_STRIPE_PUBLIC}

# File Upload (Production storage)
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Monitoring & Observability
SENTRY_DSN=${PROD_SENTRY_DSN}
NEW_RELIC_LICENSE_KEY=${PROD_NEW_RELIC_KEY}

# Security Headers & Features
HELMET_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100 