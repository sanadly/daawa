# Staging Environment Configuration
NODE_ENV=staging

# Application
APP_NAME=Daawa Staging
APP_URL=https://staging.daawa.com
API_URL=https://staging-api.daawa.com/api/v1

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=3001

# Database (Use environment variables from secrets)
DATABASE_HOST=${STAGING_DB_HOST}
DATABASE_PORT=5432
DATABASE_USERNAME=${STAGING_DB_USER}
DATABASE_PASSWORD=${STAGING_DB_PASSWORD}
DATABASE_NAME=daawa_staging
DATABASE_SSL=true
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# Redis
REDIS_HOST=${STAGING_REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${STAGING_REDIS_PASSWORD}
REDIS_DB=0

# Security (Use secrets manager)
JWT_SECRET=${STAGING_JWT_SECRET}
JWT_EXPIRES_IN=7d
SESSION_SECRET=${STAGING_SESSION_SECRET}

# Staging Tools
ENABLE_SWAGGER=true
ENABLE_CORS=true
CORS_ORIGIN=https://staging.daawa.com
LOG_LEVEL=info

# Email (Use staging email service)
SMTP_HOST=${STAGING_SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${STAGING_SMTP_USER}
SMTP_PASSWORD=${STAGING_SMTP_PASSWORD}
SMTP_FROM=staging@daawa.com

# External APIs (Staging keys)
GOOGLE_MAPS_API_KEY=${STAGING_GOOGLE_MAPS_KEY}
STRIPE_SECRET_KEY=${STAGING_STRIPE_SECRET}
STRIPE_PUBLISHABLE_KEY=${STAGING_STRIPE_PUBLIC}

# Monitoring
SENTRY_DSN=${STAGING_SENTRY_DSN} 