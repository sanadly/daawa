{
  "name": "daawa",
  "version": "1.0.0",
  "description": "Event management system with Next.js frontend and NestJS backend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:backend": "npm run build --workspace=apps/backend",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "npm run typecheck --workspaces",
    "clean": "rimraf apps/*/dist apps/*/.next apps/*/node_modules packages/*/dist packages/*/node_modules node_modules",
    "prepare": "husky",
    "secrets": "node scripts/secrets-manager.js",
    "secrets:health": "node scripts/secrets-manager.js health",
    "secrets:list": "node scripts/secrets-manager.js list",
    "secrets:generate": "node scripts/secrets-manager.js generate"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "author": "Daawa Team",
  "license": "MIT",
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@types/qrcode.react": "^1.0.5",
    "@types/recharts": "^1.8.29",
    "html5-qrcode": "^2.3.8",
    "papaparse": "^5.5.3",
    "qrcode.react": "^4.2.0",
    "react-hook-form": "^7.59.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.0.2",
    "swr": "^2.3.4",
    "zod": "^3.25.73"
  }
}
